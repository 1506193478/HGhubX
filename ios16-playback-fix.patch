+/// 解析单段 byte-range。多段与 suffix-range 解析不了时按 HTTP 规范忽略 Range、
+/// 返回完整 200，而不是给原生播放器一个错误的 206。
+fn byte_range(value: &str, len: usize) -> Option<(usize, usize)> {
+    let spec = value.trim().strip_prefix("bytes=")?;
+    if spec.contains(',') || len == 0 {
+        return None;
+    }
+    let (start, end) = spec.split_once('-')?;
+    let start: usize = start.parse().ok()?;
+    let end = if end.is_empty() {
+        len - 1
+    } else {
+        end.parse::<usize>().ok()?
+    };
+    let end = end.min(len - 1);
+    (start <= end && start < len).then_some((start, end))
+}
+
+fn partial_body<'a>(
+    parts: &mut tauri::http::response::Parts,
+    range: Option<&str>,
+    body: &'a [u8],
+) -> &'a [u8] {
+    let Some((start, end)) = range.and_then(|value| byte_range(value, body.len())) else {
+        return body;
+    };
+    if !parts.status.is_success() || body.is_empty() {
+        return body;
+    }
+    parts.status = tauri::http::StatusCode::PARTIAL_CONTENT;
+    if let Ok(value) = tauri::http::HeaderValue::from_str(&format!(
+        "bytes {start}-{end}/{}",
+        body.len()
+    )) {
+        parts.headers.insert("Content-Range", value);
+    }
+    &body[start..=end]
